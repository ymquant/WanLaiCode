{
  "name": "@opencode-ai/addon",
  "version": "0.1.8",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "build": "bun build ./src/index.ts --outdir ./dist --target node --sourcemap",
    "dev": "bun build ./src/index.ts --outdir ./dist --target node --watch"
  },
  "dependencies": {
    "effect": "catalog:",
    "tar": "catalog:"
  },
  "devDependencies": {
    "@opencode-ai/core": "workspace:*",
    "@opencode-ai/plugin": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^5.7.3"
  }
}
